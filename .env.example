# Optional. Without these the app serves clearly-labelled DEMO data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=change-me
# Opt-in. Supabase free tier allows ~200 concurrent Realtime connections; leave false unless you've sized for peak 3 PM traffic.
NEXT_PUBLIC_ENABLE_REALTIME=false
# Web push (free). Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Telegram channel (free). Create a bot with @BotFather, add it as channel admin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your_channel

# Design preview only: show fake results even with Supabase connected. Remove for real use.
USE_DEMO_DATA=false
# PIN for the /admin/live quick-entry pad (choose 6+ digits)
ADMIN_PIN=
TELEGRAM_ADMIN_CHAT_ID=
# Telegram bot webhook (forward the official PDF to your bot). Any long random string:
TELEGRAM_WEBHOOK_SECRET=
